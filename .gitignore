.DS_Store
*.log

# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# pubspec.lock IS committed. This is an app, not a library, and a device
# someone relies on to speak should build from known-good dependency versions.

# Generated — regenerate with `dart run build_runner build`
*.g.dart
*.freezed.dart

# IDE
.idea/
.vscode/
*.iml

# Local tooling
.claude/

# Terraform working directories and state. The lock file IS committed: it pins
# provider versions, and an intake that must still deploy in two years wants
# the same provider it was written against.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# The intake binary, when someone builds it in place.
/intake/intake

# The intake service and its Terraform live in wordbridge-infra.
