<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The PIN's salt lives in the keychain. A sandboxed macOS app cannot
	     reach it without this, and every write fails with -34018. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)org.wordbridge.wordbridge</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
