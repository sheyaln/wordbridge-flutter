<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The family's own iCloud, and only through this app's own container.
	     Nothing here reaches a server of ours; a backup goes to the account
	     already signed in on the iPad and stays there.

	     Not attached to the target by this file alone. Xcode's
	     CODE_SIGN_ENTITLEMENTS setting has to point at it and the provisioning
	     profile has to carry the iCloud capability, and adding either from
	     outside Xcode risks breaking signing on a build that is in review. So
	     the file is here and the two clicks are a deploy step — see
	     docs/deploy-ipad.md. Until then CloudBackup.swift answers "not signed
	     in", which is the honest state and not a crash. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.sheyaln.aac</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.sheyaln.aac</string>
	</array>
</dict>
</plist>
