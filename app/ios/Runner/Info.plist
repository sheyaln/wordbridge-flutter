<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Wordbridge</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>wordbridge</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- On iPad, an app that can share the screen must accept every
	     orientation: iOS ignores what the app asks for and rotates it anyway.
	     Without this the orientation lock is inert on exactly the device it was
	     written for, and there is no error to read.

	     Which also refuses Split View and Slide Over, and that is the right
	     answer here rather than the price of one. A board in half a screen has
	     every cell somewhere new, which is the same harm as rotating it. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- The documents folder is the app's half of import and export (§4.41
	     part 3). Without these two, an exported .obz is written somewhere no
	     human being can reach and the feature is a button that does nothing
	     anybody can see; with them, Files shows "On My iPad → wordbridge" and
	     a caregiver can mail a board out or drop one in.

	     It also exposes the backups folder, which is a fair trade rather than
	     an accident: a backup a family can copy off the tablet before a repair
	     is worth more than one only this app can see. Nothing in there is
	     reachable from outside the device — no network, no sharing service —
	     and a usage log is only ever readable by somebody already holding the
	     unlocked tablet. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Both are required by iOS before the picker will open, and an app that
	     asks without them does not fail politely: it is terminated. The symbol
	     picker offers "use my own photo" and "take a photo", so without these
	     two keys that button killed the app on a real device (§4.52).

	     Written as the reason rather than as a request. iOS puts the app name
	     and the permission in front of these words already; what a caregiver
	     does not know is what it is for. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pictures you choose here go on buttons, so a button can show the actual person, cup or place instead of a symbol.</string>
	<key>NSCameraUsageDescription</key>
	<string>Photographs taken here go on buttons, so a button can show the actual person, cup or place instead of a symbol.</string>
	<!-- Export compliance. wordbridge encrypts nothing of its own: HTTPS for
	     the report intake and the optional downloads, and a hash for the
	     caregiver PIN. Both are exempt, and declaring it here means the
	     question is not asked again on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
